# Salin file ini menjadi `.env` lalu sesuaikan bila perlu:
#   cp .env.example .env
#
# File `.env` asli tidak pernah ikut ter-commit ke git.

# Prisma: URL koneksi Postgres (Supabase). Untuk Vercel/produksi, pakai
# connection pooler (port 6543) dengan `?pgbouncer=true`.
# Contoh: postgresql://postgres:[password]@db.xxx.supabase.co:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://user:password@localhost:5432/keuangan"

# Kunci penandatangan sesi login. WAJIB: tanpa ini aplikasi menolak semua
# request. Minimal 32 karakter acak. Buat dengan:
#   openssl rand -hex 32
# Jangan diisi dengan password atau nilai contoh.
SESSION_SECRET=

# Akun admin cadangan dari environment (opsional). Jalur masuk bila akun di
# tabel User belum ada. Hapus bila sudah tidak diperlukan.
# BASIC_AUTH_USER=
# BASIC_AUTH_PASS=

# Password super admin untuk scripts/create-super-admin.ts dan scripts/setup-db.ts
# (opsional, hanya dibaca skrip itu).
# SUPER_ADMIN_PASSWORD=
